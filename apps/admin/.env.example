# Panel administrativo — solo claves PÚBLICAS. Nunca poner service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clave publishable/anon>
# Permite el formulario de registro solo para el arranque del primer superadministrador.
NEXT_PUBLIC_ALLOW_SIGNUP=false
